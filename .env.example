# Atlas auth — copy this file to .env and fill in your instance's values.
#
# Public (client + server): publishable key + Frontend API origin. These map to
# runtimeConfig.public.atlas.* and are safe in the browser bundle.
NUXT_PUBLIC_ATLAS_PUBLISHABLE_KEY=pk_test_xxx
NUXT_PUBLIC_ATLAS_FRONTEND_API=https://atlasauth.net

# Server-only JWT verification. These map to runtimeConfig.atlas.* and are
# NEVER exposed to the client.
NUXT_ATLAS_JWKS_URL=https://atlasauth.net/.well-known/jwks.json
NUXT_ATLAS_ISSUER=https://atlasauth.net
